# Copie para .env.test. Usado por `npm run test:integration` contra um Postgres local.
NODE_ENV=test
DB_URL=postgresql://postgres:postgres@localhost:5433/oficina
DB_SSL=false

JWT_SECRET=test-secret
MOCK_USER_EMAIL=admin@oficina.com
MOCK_USER_PASSWORD=123456
MOCK_USER_ID=1

NEW_RELIC_ENABLED=false
LOG_LEVEL=silent
