{
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --legacy-watch src/server.js",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "dotenvx run --env-file=.env.test -- jest tests/integration",
    "test:functional": "jest tests/functional",
    "test:coverage": "jest --coverage",
    "migrate": "node-pg-migrate -m migrations -d DB_URL",
    "migrate:up": "node-pg-migrate up -m migrations -d DB_URL",
    "migrate:down": "node-pg-migrate down -m migrations -d DB_URL",
    "migrate:create": "node-pg-migrate create -m migrations -j sql",
    "lint": "eslint .",
    "test:bdd": "jest tests/features"
  },
  "dependencies": {
    "amqplib": "^2.2.0",
    "cpf-cnpj-validator": "^1.0.3",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "newrelic": "^12.25.1",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.20.0",
    "pino": "^10.4.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.75.1",
    "@eslint/js": "^9.39.5",
    "@sonar/scan": "^4.3.6",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "jest-cucumber": "^4.5.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.2.0",
    "supertest": "^6.3.4"
  }
}
