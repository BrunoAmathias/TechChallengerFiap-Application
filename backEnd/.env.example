# Copie para .env e preencha. Nunca versione o .env.

# Conexão com o banco (tem prioridade sobre as variáveis DB_* abaixo)
# Neon: postgresql://<user>:<senha>@<host>/<db>?sslmode=require
DB_URL=
# true para Neon/produção, false para Postgres local do docker-compose
DB_SSL=true

# Alternativa ao DB_URL (usada quando DB_URL está vazio)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=oficina
DB_USER=postgres
DB_PASSWORD=

# Senha do Postgres local do docker-compose
POSTGRES_PASSWORD=

JWT_SECRET=

# Mensageria (saga). Sem RABBITMQ_URL a API sobe, mas os eventos ficam no outbox.
RABBITMQ_URL=amqp://oficina:oficina@localhost:5672
RABBITMQ_PASSWORD=oficina
# Espera entre tentativas de um evento que falhou (3 tentativas e depois DLQ)
RABBITMQ_RETRY_DELAY_MS=5000
OUTBOX_POLL_INTERVAL_MS=1000

# Token das rotas /internal (chamadas do Billing e do Execution)
SERVICE_TOKEN=

MOCK_USER_EMAIL=
MOCK_USER_PASSWORD=
MOCK_USER_ID=

NEW_RELIC_LICENSE_KEY=
NEW_RELIC_ENABLED=false

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
